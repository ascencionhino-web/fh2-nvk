diff --git a/src/nouveau/vulkan/nvk_cmd_buffer.c b/src/nouveau/vulkan/nvk_cmd_buffer.c
index b48b81f..d577a5b 100644
--- a/src/nouveau/vulkan/nvk_cmd_buffer.c
+++ b/src/nouveau/vulkan/nvk_cmd_buffer.c
@@ -969,6 +969,101 @@ nvk_cmd_frag_barrier_only(struct nvk_cmd_buffer *cmd,
 #endif
 }
 
+#ifdef HAVE_SWITCH_PLATFORM
+/* FH2 NX (NXMASTER-Ascencion H.O): lighter barriers, asked by the app (nvk_fh2_barreras).
+ *
+ * Every barrier with any source stage becomes a full WAIT_FOR_IDLE above, and FH2's native renderer opens about
+ * 70 render passes per frame, each with external dependencies: the GPU drains between passes. Measured on the
+ * console: the scene costs the same GPU time at 40 % and 55 % render scale, so the frame is not pixel bound.
+ *
+ * 0 = as always.
+ * 1 = no WFI when every barrier only orders attachment work after attachment work (source and destination stages
+ *     within colour output and the fragment tests, attachment accesses only): the 3D pipe keeps ROP order.
+ * 2 = also no WFI when the source is attachment work and the destination reads it in shaders (render-to-texture);
+ *     the texture cache is still invalidated (nvk_cmd_invalidate_deps). A TEST: it can show stale texels.
+ * 3 = 1 and 2, and every other graphics/transfer barrier on the 3D engine becomes a PIXEL_SHADER_BARRIER
+ *     (nvk_fh2_barrera_3d).
+ * The counters let the app report what was skipped.
+ */
+int nvk_fh2_barreras = 0;
+uint64_t nvk_fh2_barreras_cuentas[4]; /* WFI barriers seen, skipped by mode 1, skipped by mode 2, kept */
+
+static int
+nvk_fh2_clase_barrera(VkPipelineStageFlags2 src, VkAccessFlags2 src_acc,
+                      VkPipelineStageFlags2 dst, VkAccessFlags2 dst_acc)
+{
+   const VkPipelineStageFlags2 adj = VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT |
+                                     VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |
+                                     VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT;
+   const VkAccessFlags2 acc_adj = VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT |
+                                  VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT |
+                                  VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT |
+                                  VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+   src = vk_expand_src_stage_flags2(src);
+   dst = vk_expand_dst_stage_flags2(dst);
+   if (src & ~adj)
+      return 0;
+   if (src_acc & ~acc_adj)
+      return 0;
+   if (!(dst & ~adj) && !(dst_acc & ~acc_adj))
+      return 1;
+   const VkPipelineStageFlags2 lectura = adj | VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT |
+                                         VK_PIPELINE_STAGE_2_VERTEX_SHADER_BIT;
+   const VkAccessFlags2 acc_lectura = acc_adj | VK_ACCESS_2_SHADER_SAMPLED_READ_BIT |
+                                      VK_ACCESS_2_INPUT_ATTACHMENT_READ_BIT |
+                                      VK_ACCESS_2_SHADER_READ_BIT;
+   if (!(dst & ~lectura) && !(dst_acc & ~acc_lectura))
+      return 2;
+   return 0;
+}
+
+/* Mode 3: the 3D engine waits only for earlier pixel shading (PIXEL_SHADER_BARRIER, as deko3d's
+ * DkBarrier_Fragments) instead of a full WAIT_FOR_IDLE, for any barrier between graphics and transfer stages.
+ * FH2's render passes declare the same broad external dependencies (transfer, vertex and fragment shaders,
+ * attachments) on both sides, so modes 1 and 2 never match them. Transfers on the copy engine and compute are
+ * still ordered: switching to another subchannel waits for the 3D engine (see the WFI below), and this mode is
+ * only taken while the 3D engine is the current subchannel. Not covered: a vertex shader reading what the
+ * previous pass rendered may see it one pass late (FH2: the exposure). */
+static bool
+nvk_fh2_barrera_3d(VkPipelineStageFlags2 src, VkAccessFlags2 src_acc,
+                   VkPipelineStageFlags2 dst, VkAccessFlags2 dst_acc)
+{
+   const VkPipelineStageFlags2 graf = VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT |
+                                      VK_PIPELINE_STAGE_2_DRAW_INDIRECT_BIT |
+                                      VK_PIPELINE_STAGE_2_VERTEX_INPUT_BIT |
+                                      VK_PIPELINE_STAGE_2_INDEX_INPUT_BIT |
+                                      VK_PIPELINE_STAGE_2_VERTEX_ATTRIBUTE_INPUT_BIT |
+                                      VK_PIPELINE_STAGE_2_VERTEX_SHADER_BIT |
+                                      VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT |
+                                      VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |
+                                      VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT |
+                                      VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT |
+                                      VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT |
+                                      VK_PIPELINE_STAGE_2_COPY_BIT |
+                                      VK_PIPELINE_STAGE_2_BLIT_BIT |
+                                      VK_PIPELINE_STAGE_2_RESOLVE_BIT |
+                                      VK_PIPELINE_STAGE_2_CLEAR_BIT;
+   const VkAccessFlags2 acc = VK_ACCESS_2_INDIRECT_COMMAND_READ_BIT |
+                              VK_ACCESS_2_INDEX_READ_BIT |
+                              VK_ACCESS_2_VERTEX_ATTRIBUTE_READ_BIT |
+                              VK_ACCESS_2_UNIFORM_READ_BIT |
+                              VK_ACCESS_2_INPUT_ATTACHMENT_READ_BIT |
+                              VK_ACCESS_2_SHADER_READ_BIT |
+                              VK_ACCESS_2_SHADER_SAMPLED_READ_BIT |
+                              VK_ACCESS_2_COLOR_ATTACHMENT_READ_BIT |
+                              VK_ACCESS_2_COLOR_ATTACHMENT_WRITE_BIT |
+                              VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_READ_BIT |
+                              VK_ACCESS_2_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT |
+                              VK_ACCESS_2_TRANSFER_READ_BIT |
+                              VK_ACCESS_2_TRANSFER_WRITE_BIT;
+   src = vk_expand_src_stage_flags2(src);
+   dst = vk_expand_dst_stage_flags2(dst);
+   if (!src || (src & ~graf) || (dst & ~graf))
+      return false;
+   return !(src_acc & ~acc) && !(dst_acc & ~acc);
+}
+#endif
+
 void
 nvk_cmd_flush_wait_dep(struct nvk_cmd_buffer *cmd,
                        const VkDependencyInfo *dep,
@@ -1024,6 +1119,60 @@ nvk_cmd_flush_wait_dep(struct nvk_cmd_buffer *cmd,
    if (!(engines & (NVKMD_ENGINE_3D | NVKMD_ENGINE_COMPUTE)))
       barriers &= ~NVK_BARRIER_FLUSH_SHADER_DATA;
 
+#ifdef HAVE_SWITCH_PLATFORM
+   {
+      const int modo = p_atomic_read_relaxed(&nvk_fh2_barreras);
+      if (modo > 0 && wait && barriers == NVK_BARRIER_WFI &&
+          !(dep->dependencyFlags & VK_DEPENDENCY_ASYMMETRIC_EVENT_BIT_KHR)) {
+         int clase = 1; /* the lightest class every barrier of the dependency fits in */
+         for (uint32_t i = 0; i < dep->memoryBarrierCount && clase; i++) {
+            const VkMemoryBarrier2 *b = &dep->pMemoryBarriers[i];
+            const int c = nvk_fh2_clase_barrera(b->srcStageMask, b->srcAccessMask, b->dstStageMask, b->dstAccessMask);
+            clase = c == 0 ? 0 : MAX2(clase, c);
+         }
+         for (uint32_t i = 0; i < dep->bufferMemoryBarrierCount && clase; i++)
+            clase = 0; /* buffers: as always */
+         for (uint32_t i = 0; i < dep->imageMemoryBarrierCount && clase; i++) {
+            const VkImageMemoryBarrier2 *b = &dep->pImageMemoryBarriers[i];
+            const int c = nvk_fh2_clase_barrera(b->srcStageMask, b->srcAccessMask, b->dstStageMask, b->dstAccessMask);
+            clase = c == 0 ? 0 : MAX2(clase, c);
+         }
+         p_atomic_inc(&nvk_fh2_barreras_cuentas[0]);
+         bool psb = false;
+         if (modo >= 3 && clase != 1 &&
+             pdev->info.cls_eng3d >= MAXWELL_A &&
+             nvk_cmd_buffer_last_subchannel(cmd) == SUBC_NV9097 &&
+             !dep->bufferMemoryBarrierCount) {
+            psb = true;
+            for (uint32_t i = 0; i < dep->memoryBarrierCount && psb; i++) {
+               const VkMemoryBarrier2 *b = &dep->pMemoryBarriers[i];
+               psb = nvk_fh2_barrera_3d(b->srcStageMask, b->srcAccessMask, b->dstStageMask, b->dstAccessMask);
+            }
+            for (uint32_t i = 0; i < dep->imageMemoryBarrierCount && psb; i++) {
+               const VkImageMemoryBarrier2 *b = &dep->pImageMemoryBarriers[i];
+               psb = b->srcQueueFamilyIndex == b->dstQueueFamilyIndex &&
+                     b->oldLayout != VK_IMAGE_LAYOUT_UNDEFINED &&
+                     b->oldLayout != VK_IMAGE_LAYOUT_PREINITIALIZED &&
+                     nvk_fh2_barrera_3d(b->srcStageMask, b->srcAccessMask, b->dstStageMask, b->dstAccessMask);
+            }
+         }
+         if (psb) {
+            /* counted with mode 2 ("lectura de textura") */
+            p_atomic_inc(&nvk_fh2_barreras_cuentas[2]);
+            struct nv_push *p = nvk_cmd_buffer_push(cmd, 2);
+            __push_immd(p, SUBC_NV9097, NVB197_PIXEL_SHADER_BARRIER,
+                        NVB197_PIXEL_SHADER_BARRIER_SYSMEMBAR_ENABLE_FALSE);
+            barriers &= ~NVK_BARRIER_WFI;
+         } else if (clase != 0 && clase <= modo) {
+            p_atomic_inc(&nvk_fh2_barreras_cuentas[clase]);
+            barriers &= ~NVK_BARRIER_WFI;
+         } else {
+            p_atomic_inc(&nvk_fh2_barreras_cuentas[3]);
+         }
+      }
+   }
+#endif
+
    if (!barriers)
       return;
 
